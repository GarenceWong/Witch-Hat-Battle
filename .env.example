# Firebase web config. Copy this file to `.env` and fill in your project's values.
# Find them in Firebase Console → Project settings → General → Your apps → SDK setup.
# These VITE_* vars are baked into the client bundle at build time (not secret —
# a Firebase web API key is meant to be public; secure the project via API key
# restrictions + Realtime Database security rules instead).
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
